cabal-version:      3.14
name:               eventchain-bench
version:            0.1.0.0
synopsis:           What the Verifier runs at, what contention costs Producers, and what a Hub's checks cost
description:
    Four benchmarks. @verify@: a Producer-written AOF, verified end to end.
    @contention@: many Producers signing against one head through a Hub
    modelled as a compare-and-swap append, measured against what that model
    predicts. @batching@: the same Hub and Producers, with each submission a
    batch of chained events, to measure what batching buys at the ceiling.
    @hub-append@: the Hub behind one thread, checking every line with the
    Verifier before it writes, against the same Hub checking only the head.
    Recorded rather than asserted — throughput is a property of the
    machine it is measured on, and the numbers live in @docs/research/@ next
    to what they are compared against, the way @eventchain-crypto@'s bench
    records the kernels'.

    A package of its own because neither side can host the measurement.
    @eventchain-verify@ may not depend on @eventchain@ (ADR-0005), so it cannot
    produce the file it would time; @eventchain@'s suites avoid the Verifier on
    purpose, because "our decoder reads our encoder" is the tautology they
    exist to avoid. Depending on both from a package that ships nothing, and
    that nothing depends on, leaves both boundaries where they were — the
    shape @gates@ already has.

    __Never depend on this package.__ It is not published.
license:            BSD-3-Clause
license-file:       LICENSE
author:             EventChain contributors
maintainer:         raam@cornerstone.red
category:           Testing
build-type:         Simple
tested-with:        GHC ==9.12.4

-- -threaded and -rtsopts so the same binary measures one capability and all
-- of them: `cabal run eventchain-bench:verify` and the same with
-- `-- +RTS -N`. Neither flag changes what is measured unless passed.
-- No -O2, for the reason eventchain-crypto's bench gives: the libraries ship
-- at cabal's default, and a loop measured at -O2 measures something no
-- caller gets.
benchmark verify
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            Main.hs
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded -rtsopts

    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , eventchain
        , eventchain-crypto
        , eventchain-verify
        , text              >=2.1  && <2.3
        , time              >=1.12 && <1.15

-- Many Producers signing against one head, with a Hub modelled as a
-- compare-and-swap append (see bench/contention/Contention/Hub.hs). -N by
-- default because the measurement needs a capability per Producer: the
-- harness refuses to run with fewer than it needs, so the flag is a
-- convenience, not something that changes what is measured.
benchmark contention
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench/contention
    main-is:            Main.hs
    other-modules:
        Contention.Cell
        Contention.Hub
        Contention.Predict
        Contention.Processor
        Contention.Producer
        Contention.Refusals
        Contention.Sweep
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded -rtsopts "-with-rtsopts=-N"

    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , containers        >=0.7  && <0.9
        , directory         >=1.3  && <1.4
        , eventchain
        , eventchain-crypto
        , eventchain-verify
        , filepath          >=1.5  && <1.6
        , text              >=2.1  && <2.3

-- The contention harness with each submission a batch of chained events
-- (see bench/contention/Batching.hs). Same modules, same Hub, same -N for the
-- same reason; only the defaults differ.
benchmark batching
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench/contention
    main-is:            Batching.hs
    other-modules:
        Contention.Cell
        Contention.Hub
        Contention.Predict
        Contention.Processor
        Contention.Producer
        Contention.Refusals
        Contention.Sweep
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded -rtsopts "-with-rtsopts=-N"

    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , containers        >=0.7  && <0.9
        , directory         >=1.3  && <1.4
        , eventchain
        , eventchain-crypto
        , eventchain-verify
        , filepath          >=1.5  && <1.6
        , text              >=2.1  && <2.3

-- The Hub behind one thread, checking every line before it writes, against
-- the same Hub checking only the head (see bench/contention/HubAppend.hs).
-- Same modules; -N because the Hub thread needs a capability too.
benchmark hub-append
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench/contention
    main-is:            HubAppend.hs
    other-modules:
        Contention.Cell
        Contention.Hub
        Contention.Predict
        Contention.Processor
        Contention.Producer
        Contention.Refusals
        Contention.Sweep
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded -rtsopts "-with-rtsopts=-N"

    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , containers        >=0.7  && <0.9
        , directory         >=1.3  && <1.4
        , eventchain
        , eventchain-crypto
        , eventchain-verify
        , filepath          >=1.5  && <1.6
        , text              >=2.1  && <2.3
