cabal-version:      3.14
name:               eventchain-crypto
version:            0.1.0.0
synopsis:
    Shared types for the EventChain protocol's cryptographic kernels
description:
    The quantities EventChain's cryptographic kernels operate on: AOF line
    bytes and payload bytes, SHA-256 digests typed by what was hashed, P-256
    keys, and raw signatures. Constructors are unexported; validating smart
    constructors are the only door, so holding a value proves its shape was
    checked.

    Both the Producer (@eventchain@) and the Verifier (@eventchain-verify@)
    depend on this package, which is a decision rather than a convenience.
    Format logic is deliberately /not/ shared between them — two
    independently written canonicalizers that agree are evidence, where one
    shared canonicalizer is an assumption — but nothing here encodes a format
    judgment. A digest is 32 bytes and a compressed point is 33; no two
    implementations could reach those differently, so sharing them forfeits no
    evidence while keeping the memory-safety obligation in one place.

    Protocol specification: <https://eventchain-protocol.github.io/>
license:            BSD-3-Clause
license-file:       LICENSE
author:             EventChain contributors
maintainer:         raam@cornerstone.red
category:           Cryptography
build-type:         Simple
-- Only what is built. 9.10.3 and 9.14.1 were claimed here on the strength of a
-- CI matrix that no longer exists -- and never did build them. Widening this is
-- one line and a green build; claiming it without one is how a stranger's build
-- breaks on our word.
tested-with:        GHC ==9.12.4

-- The vendored assembly's header and licence travel with the sdist; the
-- `.S` files themselves are picked up from `asm-sources`.
extra-source-files:
    cbits/eventchain-s2n-bignum.h
    cbits/s2n-bignum/include/_internal_s2n_bignum_arm.h
    cbits/s2n-bignum/include/s2n-bignum.h
    cbits/s2n-bignum/LICENSE
    cbits/s2n-bignum/NOTICE
    cbits/s2n-bignum/README.md

-- One exposed facade over hidden type modules -- aeson's shape for
-- `Data.Aeson.Types` over `Data.Aeson.Types.Internal`. The inventory ships in
-- `other-modules` so that a hidden module's unexported constructor cannot be
-- named from outside no matter what a caller imports: that is what makes the
-- smart-constructor discipline hold at the package edge rather than only at
-- the module edge.
library
    hs-source-dirs:     src
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

    exposed-modules:
        EventChain.Crypto
        EventChain.Crypto.Types

    other-modules:
        EventChain.Crypto.Internal.Digest
        EventChain.Crypto.Internal.Ecdsa
        EventChain.Crypto.Internal.Precomputed
        EventChain.Crypto.Internal.Error
        EventChain.Crypto.Internal.Foreign
        EventChain.Crypto.Types.Internal.Bytes
        EventChain.Crypto.Types.Internal.Error
        EventChain.Crypto.Types.Internal.Hash
        EventChain.Crypto.Types.Internal.Key

    -- A seam, not a library. Nothing else belongs on this list.
    build-depends:
        , base       >=4.20 && <5
        , bytestring >=0.12 && <0.14

    -- >=3.2 is where deterministic ECDSA (RFC 6979) lands; ADR-0004 depends on
    -- it, so the floor is declared rather than hoped for. A stock Linux LTS
    -- ships 3.0.x and will fail to solve here, which is the intent: the
    -- alternative is signatures whose nonces come from somewhere we did not
    -- choose. macOS: Homebrew's openssl@3 is keg-only, so PKG_CONFIG_PATH must
    -- point at it (see the README).
    pkgconfig-depends:  libcrypto >=3.2

    -- ADR-0004 as amended: ECDSA-P256 verification runs on vendored s2n-bignum
    -- assembly (fixed-base scalar multiplication from a per-key table), which
    -- is where the 2x over libcrypto's verify comes from. The sources are
    -- byte-for-byte upstream copies -- see cbits/s2n-bignum/README.md for the
    -- commit and the refresh procedure. arm64 only until a build has run
    -- elsewhere: the x86-64 twins are a separate vendoring under the other
    -- arch branch, and `tested-with` lists what is built, not what is hoped.
    if !arch(aarch64)
        -- Refused rather than linked without the kernel: the FFI seam names
        -- these symbols, so a build here would fail at link time of the first
        -- test suite with a message about them, and this says why first.
        buildable: False
    if arch(aarch64)
        include-dirs:   cbits cbits/s2n-bignum/include
        asm-sources:
            cbits/s2n-bignum/arm/bignum_bigendian_4.S
            cbits/s2n-bignum/arm/bignum_demont_p256.S
            cbits/s2n-bignum/arm/bignum_eq.S
            cbits/s2n-bignum/arm/bignum_lt.S
            cbits/s2n-bignum/arm/bignum_mod_n256.S
            cbits/s2n-bignum/arm/bignum_mod_n256_4.S
            cbits/s2n-bignum/arm/bignum_modinv.S
            cbits/s2n-bignum/arm/bignum_montinv_p256.S
            cbits/s2n-bignum/arm/bignum_montmul_p256.S
            cbits/s2n-bignum/arm/bignum_montsqr_p256.S
            cbits/s2n-bignum/arm/bignum_mul_4_8.S
            cbits/s2n-bignum/arm/bignum_nonzero_4.S
            cbits/s2n-bignum/arm/bignum_tomont_p256.S
            cbits/s2n-bignum/arm/p256_montjdouble.S
            cbits/s2n-bignum/arm/p256_montjmixadd.S
            cbits/s2n-bignum/arm/p256_scalarmulbase.S

-- The kernels are graded by bytes we did not choose. `docs/plan.md` asked for
-- OpenSSL CLI fixtures; those are the same libcrypto we call, so they prove
-- wiring and not correctness. RFC 6979 and FIPS 180-2 publish the answers.
--
-- The properties are where the FFI marshalling is tested. A fuzzer was
-- considered and rejected on evidence: AFL++ cannot instrument GHC's output,
-- and ASan cannot see GHC's pinned heap, so neither reaches the code at risk.
test-suite kat
    type:               exitcode-stdio-1.0
    hs-source-dirs:     tests
    main-is:            Main.hs
    default-language:   GHC2024

    -- Identical to the library's list on purpose: StrictData changes
    -- evaluation, so a suite built without it exercises different code.
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded

    other-modules:
        Test.EventChain.Crypto.Hex
        Test.EventChain.Crypto.Kat
        Test.EventChain.Crypto.Properties

    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , eventchain-crypto
        , hedgehog          >=1.5  && <1.8
        , tasty             >=1.5  && <1.6
        , tasty-hedgehog    >=1.4  && <1.5
        , tasty-hunit       >=0.10 && <0.11

-- Recorded, not asserted: throughput is a property of the machine. See the
-- module header.
benchmark bench
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            Main.hs
    default-language:   GHC2024
    default-extensions:
        StrictData
        DerivingVia
        PatternSynonyms
        NoFieldSelectors
        OverloadedRecordDot

    -- No -O2: the library ships at cabal's default -O1, so measuring the
    -- benchmark's own loop at -O2 would measure something no caller gets.
    -- -rtsopts so `+RTS -s` can show the allocation profile alongside the
    -- throughput; it changes nothing unless RTS flags are passed.
    ghc-options:        -Wall -threaded -rtsopts
    build-depends:
        , base              >=4.20 && <5
        , bytestring        >=0.12 && <0.14
        , eventchain-crypto
        , time              >=1.12 && <1.15
